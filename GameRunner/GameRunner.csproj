<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Engine\TalesOfTribute.csproj" />
      <ProjectReference Include="..\gRPC\gRPC.csproj" />
      <ProjectReference Include="..\Bots\Bots.csproj">
        <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      </ProjectReference>
    </ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

    <ItemGroup>
      <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    </ItemGroup>

    <Target Name="CopyBotsToOutput" AfterTargets="Build">
      <Copy SourceFiles="$(MSBuildThisFileDirectory)..\Bots\bin\$(Configuration)\netstandard2.1\Bots.dll"
            DestinationFolder="$(OutputPath)Bots\" />
    </Target>

</Project>
